# Kopieren nach .scrollcraft-wp.env und ausfuellen. Die echte Datei gehoert
# nicht ins Repo, sie steht in .gitignore.
#
# Zugang zum Staging-Server. mediathek.sh und die Deploy-Schritte lesen das.
SCWP_HOST="uXXXXXXXXX@1.2.3.4"
SCWP_PORT=65002
SCWP_KEY="$HOME/.ssh/id_ed25519"
SCWP_WP="/home/uXXXXXXXXX/domains/staging.example.de/public_html"

# Die oeffentliche Adresse derselben Installation. Der Screenshot-Lauf zielt
# darauf, mit angehaengtem Cache-Brecher.
SCWP_URL="https://staging.example.de"

# Nur noetig, wenn ueber kie.ai statt ueber den Higgsfield-MCP erzeugt wird.
# KIE_AI_API_KEY=
